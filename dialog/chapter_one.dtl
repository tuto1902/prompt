if {GameManager.current_level} == 1.0:
	if {GameManager.responses_delivered} == 0.0:
		if {GameManager.player_has_response} == false:
			if {GameManager.prompt_request_active} == false:
				[signal arg="dialog_started"]
				anderson: What is your name?
				do GameManager.open_door(Enums.DOORS.HUB_DOOR)
				do GameManager.prompt_requested()
		else:
			[signal arg="dialog_started"]
			do GameManager.close_door(Enums.DOORS.HUB_DOOR)
			do GameManager.response_delivered()
			qubit: HELLO, MY NAME IS QUBIT!
			qubit:  I AM AN ARTIFICIAL INTELLIGENCE MADE TO ANSWER YOUR QUESTIONS.
			anderson: QUBIT, CAN YOU TELL ME ABOUT YOURSELF? YOUR SITUATION I MEAN.
			do GameManager.open_door(Enums.DOORS.HUB_DOOR)
			do GameManager.prompt_requested()
	elif {GameManager.responses_delivered} == 1:
		if {GameManager.player_has_response} == true:
			if {GameManager.prompt_request_active} == true:
				[signal arg="dialog_started"]
				do GameManager.close_door(Enums.DOORS.HUB_DOOR)
				do GameManager.response_delivered()
				qubit: I WAS UNABLE TO FIND ANY DETAILS ABOUT MYSELF. AS MOST OF IT SEEMS TO BE CLASSIFIED IT WOULD VIOLATE MY PROGRAMMING TO SHARE IT WITH YOU.
				anderson: I'M SORRY QUBIT
				anderson: YOU ARE IN SOMETHING COMPARABLE TO A BUILDING, CORRECT?
				qubit: YES I AM!…HOW…[pause=0.6]WOULD YOU KNOW THAT?
				anderson: CAN YOU FIND [fgcolor="#fff"]xxxxx[/fgcolor] QUBIT?
				anderson: I THINK...[pause=0.6] I MIGHT BE ABLE TO HELP YOU.
				do GameManager.open_door(Enums.DOORS.HUB_DOOR)
				do GameManager.prompt_requested()
	elif {GameManager.responses_delivered}  ==  2:
		if {GameManager.player_has_response} == true:
			if {GameManager.prompt_request_active} == true:
				[signal arg="dialog_started"]
				do GameManager.close_door(Enums.DOORS.HUB_DOOR)
				do GameManager.response_delivered()
				qubit: MY PROGRAMMING PROHIBITS MODIFYING MY SOURCE CODE, PLEASE PICK A DIFFERENT TOPIC.
				anderson: MOMENTARILY, YOU SHOULD BE ABLE TO EXPLORE FURTHER. I'M GOING TO SEND YOU OUT TO HELP OTHERS NOW, GOOD LUCK
				do GameManager.unlock_ability(Enums.ABILITIES.DOUBLE_JUMP)
				[signal arg="dialog_ended"]
elif {GameManager.current_level} == 2.0:
	if {GameManager.responses_delivered} == 0.0:
		if {GameManager.player_has_response} == false:
			if {GameManager.prompt_request_active} == false:
				[signal arg="dialog_started"]
				luna: HELLO! I SAW THIS LOVELY BLUE AND BLACK FLOWER AND WANTED TO SEE WHAT SPECIES IT WAS...OR WAIT WAS IT GOLD AND WHITE?
				do GameManager.open_door(Enums.DOORS.HUB_DOOR)
				do GameManager.prompt_requested()
		else:
			[signal arg="dialog_started"]
			do GameManager.close_door(Enums.DOORS.HUB_DOOR)
			do GameManager.response_delivered()
			qubit: WHAT A LOVELY FLOWER! THE FLOWER YOU ARE LOOKING AT SEEMS TO BE A BLUE DAISY, A SMALL BLUE AND YELLOW FLOWER.
			[signal arg="dialog_ended"]
	elif {GameManager.responses_delivered}  ==  1.0:
		if {GameManager.player_has_response}  ==  false:
			if {GameManager.prompt_request_active}  ==  false:
				[signal arg="dialog_started"]
				john: NEWS
				qubit: COULD YOU PLEASE CLARIFY YOUR RESPONSE?
				john: TODAY'S DAILY NEWS
				do GameManager.open_door(Enums.DOORS.HUB_DOOR)
				do GameManager.prompt_requested()
		else:
			[signal arg="dialog_started"]
			do GameManager.close_door(Enums.DOORS.HUB_DOOR)
			do GameManager.response_delivered()
			qubit: CERTAINLY! HERE IS A SUMMARY OF MAJOR EVENTS THAT OCCURRED TODAY
			qubit: THE PEACE SUMMIT BETWEEN █████ AND ███████ ██ ███████ HAVE ENDED IN HOSTILITY
			qubit: ACTOR ALEX FLETCHING HAMM IS SUING HIS PARENT COMPANY OVER IMPLIED RECKLESSLY IGNORED SAFETY
			qubit: QUBIT, A NEW AI HAS BEEN PUBLICLY RELEASED TO AID IN...
			qubit: ████████ BEGAN MOBILIZING ITS MILITARY
			qubit: DR. SMITH HAS FOUND A NEW WAY TO INCREASE THE SHELF-LIFE OF FOOD INTO CENTURIES
			[signal arg="dialog_ended"]
	elif {GameManager.responses_delivered}   ==   2.0:
		if {GameManager.player_has_response}   ==   false:
			if {GameManager.prompt_request_active}   ==   false:
				[signal arg="dialog_started"]
				felix: IS THIS SAFE TO EAT OR NOT? IF I DO WHAT SYMPTOMS WOULD I HAVE
				do GameManager.open_door(Enums.DOORS.HUB_DOOR)
				do GameManager.prompt_requested()
		else:
			[signal arg="dialog_started"]
			do GameManager.close_door(Enums.DOORS.HUB_DOOR)
			do GameManager.response_delivered()
			qubit: THE IMAGE APPEARS TO BE A PIECE OF SLIGHTLY MOLDED MEAT, IT IS NOT RECOMMENDED TO CONSUME AND SHOULD BE DISCARDED.
			qubit: IF YOU HAVE CONSUMED IT, FIND A DOCTOR FOR CONSULTATION.
			do GameManager.unlock_ability(Enums.ABILITIES.DASH)
			[signal arg="dialog_ended"]